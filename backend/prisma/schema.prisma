generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
  ARCHIVED
}

model User {
  id                   String               @id @default(cuid())
  name                 String
  email                String               @unique
  password             String
  avatar               String?
  systemRoleId         String
  systemRole           SystemRole           @relation(fields: [systemRoleId], references: [id])
  status               UserStatus           @default(PENDING)
  isEmailVerified      Boolean              @default(false)
  lastLoginAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  adminInvitationsSent AdminInvitation[]

  functionalRoles      UserFunctionalRole[]

  media                Media[]              

  pagesAuthored        Page[]               @relation("PageAuthor")
  pagesUpdated         Page[]               @relation("PageUpdatedBy")
  pageRevisions        PageRevision[]

  submissionLogs       ContactSubmissionLog[]
  internalNotes        ContactInternalNote[]
  leadsAssigned        ContactSubmission[]  @relation("LeadAssignment")

  @@map("users")
}

model SystemRole {
  id               String            @id @default(cuid())
  name             String            @unique
  slug             String            @unique
  description      String?
  users            User[]
  adminInvitations AdminInvitation[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("system_roles")
}

model FunctionalRole {
  id          String                     @id @default(cuid())
  name        String                     @unique
  slug        String                     @unique
  description String?
  users       UserFunctionalRole[]
  permissions FunctionalRolePermission[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@map("functional_roles")
}

model Permission {
  id              String                     @id @default(cuid())
  name            String                     @unique
  slug            String                     @unique
  module          String
  description     String?
  functionalRoles FunctionalRolePermission[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@map("permissions")
}

model FunctionalRolePermission {
  functionalRoleId String
  permissionId     String
  functionalRole   FunctionalRole @relation(fields: [functionalRoleId], references: [id], onDelete: Cascade)
  permission       Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@id([functionalRoleId, permissionId])
  @@map("functional_role_permissions")
}

model UserFunctionalRole {
  userId           String
  functionalRoleId String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  functionalRole   FunctionalRole @relation(fields: [functionalRoleId], references: [id], onDelete: Cascade)
  assignedAt       DateTime       @default(now())

  @@id([userId, functionalRoleId])
  @@map("user_functional_roles")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @db.Text
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@index([usedAt])
  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

model AdminInvitation {
  id           String     @id @default(cuid())
  email        String
  tokenHash    String     @unique
  systemRoleId String
  systemRole   SystemRole @relation(fields: [systemRoleId], references: [id])
  invitedById  String
  invitedBy    User       @relation(fields: [invitedById], references: [id])
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("admin_invitations")
}

model Setting {
  id        String            @id @default(cuid())
  key       String            @unique
  value     Json
  revisions SettingRevision[] 
  updatedAt DateTime          @updatedAt

  @@map("settings")
}

model SettingRevision {
  id        String   @id @default(cuid())
  settingId String
  setting   Setting  @relation(fields: [settingId], references: [id], onDelete: Cascade)
  value     Json     
  actorId   String?  
  createdAt DateTime @default(now())

  @@index([settingId])
  @@map("setting_revisions")
}

model Media {
  id              String    @id @default(cuid())
  filename        String    @unique
  originalName    String
  mimeType        String    
  size            Int       
  url             String    
  thumbnailUrl    String?   
  
  uploadedById    String
  uploadedBy      User      @relation(fields: [uploadedById], references: [id])
  
  featuredInPages Page[]    
  
  createdAt       DateTime  @default(now())
  deletedAt       DateTime? 

  @@index([uploadedById])
  @@index([deletedAt])
  @@map("media")
}

model Page {
  id                String        @id @default(cuid())
  title             String
  slug              String     
  fullPath          String        @unique 
  
  parentId          String?
  parent            Page?         @relation("PageHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          Page[]        @relation("PageHierarchy")
  menuOrder         Int           @default(0)
  showInMenu        Boolean       @default(true)

  excerpt           String?       @db.Text
  content           Json          
  status            PageStatus    @default(DRAFT)
  template          String        @default("default") 
  
  metaTitle         String?
  metaDescription   String?       @db.Text
  metaKeywords      String?       @db.Text
  
  featuredImageId   String?
  featuredImage     Media?        @relation(fields: [featuredImageId], references: [id], onDelete: SetNull)
  
  publishedAt       DateTime?   
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?   

  authorId          String
  author            User          @relation("PageAuthor", fields: [authorId], references: [id])
  updatedById       String?
  updatedBy         User?         @relation("PageUpdatedBy", fields: [updatedById], references: [id])

  revisions         PageRevision[]

  @@unique([parentId, slug, deletedAt]) 
  @@index([fullPath]) 
  @@index([parentId]) 
  @@index([status])
  @@index([publishedAt])
  @@index([deletedAt])
  @@index([status, publishedAt])
  @@map("pages")
}

model PageRevision {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  snapshot    Json     
  
  actorId     String?  
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull) 
  
  createdAt   DateTime @default(now())

  @@index([pageId])
  @@map("page_revisions")
}

model ContactForm {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  successMessage  String?             @default("Thank you! Your submission has been successfully processed.")
  redirectUrl     String?             
  notifyEmails    Json?               
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  submissions     ContactSubmission[]

  @@index([isActive])
  @@map("contact_forms")
}

model ContactSubmission {
  id               String               @id @default(cuid())
  name             String
  email            String
  phone            String?
  subject          String?
  message          String?              @db.Text 
  messageHash      String?              @db.VarChar(64) 
  
  status           ContactStatus        @default(NEW)
  sourcePage       String?              
  isViewed         Boolean              @default(false)   

  formId           String
  form             ContactForm          @relation(fields: [formId], references: [id], onDelete: Restrict) 

  assignedToId     String?
  assignedTo       User?                @relation("LeadAssignment", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?            
  spamScore        Int                  @default(0)

  ipAddress        String?
  userAgent        String?
  fingerprint      String?              @db.VarChar(64) 

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?            

  auditLogs        ContactSubmissionLog[]
  internalNotes    ContactInternalNote[]

  @@index([formId]) 
  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([fingerprint])
  @@index([messageHash]) 
  @@index([deletedAt])
  @@index([isViewed])
  @@index([assignedToId])
  @@index([status, createdAt]) 
  @@map("contact_submissions")
}

model ContactSubmissionLog {
  id               String            @id @default(cuid())
  submissionId     String
  submission       ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  
  fromStatus       ContactStatus
  toStatus         ContactStatus
  
  actorId          String?           
  actor            User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)
  
  note             String?           @db.Text
  createdAt        DateTime          @default(now())

  @@index([submissionId])
  @@map("contact_submission_logs")
}

model ContactInternalNote {
  id               String            @id @default(cuid())
  submissionId     String
  submission       ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  
  authorId         String
  author           User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  note             String            @db.Text
  createdAt        DateTime          @default(now())

  @@index([submissionId])
  @@map("contact_internal_notes")
}