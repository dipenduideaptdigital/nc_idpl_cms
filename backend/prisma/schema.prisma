generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

model User {
  id                   String               @id @default(cuid())
  name                 String
  email                String               @unique
  password             String
  avatar               String?
  systemRoleId         String
  systemRole           SystemRole           @relation(fields: [systemRoleId], references: [id])
  status               UserStatus           @default(PENDING)
  isEmailVerified      Boolean              @default(false)
  lastLoginAt          DateTime?
  refreshTokens        RefreshToken[]
  functionalRoles      UserFunctionalRole[]
  adminInvitationsSent AdminInvitation[]
  passwordResetTokens  PasswordResetToken[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@map("users")
}

model SystemRole {
  id               String            @id @default(cuid())
  name             String            @unique
  slug             String            @unique
  description      String?
  users            User[]
  adminInvitations AdminInvitation[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("system_roles")
}

model FunctionalRole {
  id          String                     @id @default(cuid())
  name        String                     @unique
  slug        String                     @unique
  description String?
  users       UserFunctionalRole[]
  permissions FunctionalRolePermission[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@map("functional_roles")
}

model Permission {
  id              String                     @id @default(cuid())
  name            String                     @unique
  slug            String                     @unique
  module          String
  description     String?
  functionalRoles FunctionalRolePermission[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@map("permissions")
}

model FunctionalRolePermission {
  functionalRoleId String
  permissionId     String
  functionalRole   FunctionalRole @relation(fields: [functionalRoleId], references: [id], onDelete: Cascade)
  permission       Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@id([functionalRoleId, permissionId])
  @@map("functional_role_permissions")
}

model UserFunctionalRole {
  userId           String
  functionalRoleId String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  functionalRole   FunctionalRole @relation(fields: [functionalRoleId], references: [id], onDelete: Cascade)
  assignedAt       DateTime       @default(now())

  @@id([userId, functionalRoleId])
  @@map("user_functional_roles")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @db.Text
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@index([usedAt])
  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

model AdminInvitation {
  id           String     @id @default(cuid())
  email        String
  tokenHash    String     @unique
  systemRoleId String
  systemRole   SystemRole @relation(fields: [systemRoleId], references: [id])
  invitedById  String
  invitedBy    User       @relation(fields: [invitedById], references: [id])
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("admin_invitations")
}